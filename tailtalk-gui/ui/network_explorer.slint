import { Button, ComboBox, CheckBox, LineEdit, HorizontalBox, VerticalBox, ScrollView, TextEdit, Palette } from "std-widgets.slint";

/// One device the explorer found via NBP. Every flag is decided in Rust from
/// the registration's NBP type, so the UI never has to know the type strings.
export struct DeviceRow {
    name: string,
    /// Human-readable family, e.g. "LaserWriter (PostScript)" or "File Server".
    /// An unrecognised NBP type is its own label, so nothing is lost here.
    kind: string,
    address: string,
    /// Emoji standing in for the device's type.
    icon: string,
    /// Round-trip time from the last AEP probe, already formatted ("12 ms"),
    /// or a placeholder while probing / when nothing answered.
    latency: string,
    /// False while probing and when the node never answered, so the sidebar can
    /// grey the reading out rather than showing "lost" as if it were a time.
    latency-ok: bool,
    /// Whether this family's detail pane offers any editable setting at all.
    has-settings: bool,
    is-stylewriter: bool,
    is-imagewriter: bool,
    is-laserwriter: bool,
}

/// One line of the queried information panel. A section row renders as a
/// heading and ignores `value`; every other row is a label/value pair, kept in
/// two columns so they line up under the proportional system font.
export struct InfoRow {
    label: string,
    value: string,
    is-section: bool,
}

/// Height of a text-entry row. A LineEdit and a ComboBox both report a stretchy
/// vertical size, and a layout takes its own stretch factor from its children,
/// so pinning the rows that hold them is not enough: left to itself the pair
/// would swallow the pane's spare height and squeeze the information panel into
/// a scrollbox. Fixing the widgets settles it, and matches the Buttons
/// elsewhere in the pane, which are this tall of their own accord.
global Layout {
    out property <length> row-height: 32px;
    /// Width of the settings label column. Fixed rather than a minimum, so
    /// "Default Paper Size" does not push its control further right than the
    /// shorter labels push theirs.
    out property <length> label-width: 150px;
}

/// A numeric entry that enforces its range.
///
/// std-widgets' SpinBox cannot: it rejects an out-of-range typed value but
/// leaves the typed text on screen and never resyncs it, so the field can read
/// 99999 while the value behind it is still 64, with nothing to tell the two
/// apart. Owning the text is what makes the limit real.
component NumberField inherits LineEdit {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in-out property <int> value: minimum;

    input-type: number;
    horizontal-alignment: right;

    init => {
        root.text = root.value;
    }

    // The ceiling is enforced as it is typed, since digits past the maximum are
    // never what was meant. The floor waits for the value to be committed, so
    // typing "1" on the way to "10" is not snapped straight up to the minimum.
    edited => {
        if root.text.is-float() {
            root.value = Math.min(root.text.to-float(), root.maximum);
            if root.text.to-float() > root.maximum {
                root.text = root.value;
            }
        }
    }

    accepted => {
        root.commit();
    }

    // Leaving the field is the other way a half-typed number gets committed.
    changed has-focus => {
        if !root.has-focus {
            root.commit();
        }
    }

    function commit() {
        root.value = Math.max(root.minimum,
            Math.min(root.maximum, root.text.is-float() ? root.text.to-float() : root.value));
        root.text = root.value;
    }
}

/// One figure from a ping run, shown as a tile so the four headline numbers
/// read at a glance instead of as another label/value list.
component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;

    background: Palette.background;
    border-radius: 6px;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 10px;
            color: Palette.foreground.darker(0.3);
            horizontal-alignment: center;
        }
        Text {
            text: root.value;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component NetworkExplorerWindow inherits Window {
    title: "Network Explorer";
    min-width: 660px;
    min-height: 560px;
    preferred-width: 820px;
    preferred-height: 640px;

    in property <[DeviceRow]> devices;
    in-out property <int> selected: -1;
    in property <bool> busy: false;
    // Queried detail for the selected device (read-only).
    in property <[InfoRow]> info-rows;
    // Set instead of `info-rows` when the query failed outright.
    in property <string> error-text: "";
    in-out property <string> status-text: "";
    // True once a query has populated the editable controls below.
    in property <bool> detail-loaded: false;

    // Editable fields. Which apply depends on the selected device's kind.
    in-out property <string> edit-name;                 // rename (printer families)
    in property <int> name-max: 31;                     // set per family from Rust
    in-out property <int> paper-index: 0;               // LaserWriter default paper
    in-out property <bool> startup-enabled: false;      // LaserWriter power-on test page

    // ── Ping test ────────────────────────────────────────────────────────────
    in-out property <int> ping-count: 10;
    in-out property <int> ping-size: 64;
    // Set from Rust, which owns these limits: the payload ceiling is what one
    // DDP datagram can carry, and the floor is the sequence tag a probe needs.
    in property <int> ping-size-min: 4;
    in property <int> ping-size-max: 585;
    in property <int> ping-count-max: 500;
    in property <bool> ping-busy: false;
    // The four figures below hold a placeholder until a run fills them in; the
    // tiles stay on screen so starting a test never moves the pane under the cursor.
    in property <string> ping-average: "—";
    in property <string> ping-fastest: "—";
    in property <string> ping-slowest: "—";
    in property <string> ping-loss: "—";
    in property <string> ping-status: "";

    property <bool> has-selection: root.selected >= 0 && root.selected < root.devices.length;
    property <DeviceRow> sel: root.has-selection
        ? root.devices[root.selected]
        : { name: "", kind: "", address: "", icon: "", latency: "", latency-ok: false,
            has-settings: false, is-stylewriter: false, is-imagewriter: false,
            is-laserwriter: false };

    callback refresh();
    callback query(int);
    callback save(int);
    callback run-ping-test(int);
    callback stop-ping-test();

    HorizontalBox {
        padding: 0;
        spacing: 0;

        // ── Sidebar: discovered devices ──────────────────────────────────────
        Rectangle {
            width: 260px;
            background: Palette.alternate-background;

            VerticalBox {
                padding: 10px;
                spacing: 8px;

                HorizontalBox {
                    padding: 0;
                    Text {
                        text: "Devices";
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Refresh";
                        enabled: !root.busy;
                        clicked => { root.refresh(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    ScrollView {
                        VerticalBox {
                            padding: 0;
                            spacing: 2px;
                            alignment: start;

                            for row[i] in root.devices : Rectangle {
                                height: 54px;
                                border-radius: 6px;
                                background: i == root.selected
                                    ? Palette.accent-background
                                    : (touch.has-hover ? Palette.background : transparent);

                                touch := TouchArea {
                                    clicked => {
                                        root.selected = i;
                                        root.query(i);
                                    }
                                }

                                HorizontalBox {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;

                                    // Icon, with the round-trip time beneath it.
                                    VerticalLayout {
                                        width: 46px;
                                        spacing: 1px;
                                        alignment: center;
                                        Text {
                                            text: row.icon;
                                            font-size: 20px;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: row.latency;
                                            font-size: 9px;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                            color: i == root.selected
                                                ? Palette.accent-foreground
                                                : (row.latency-ok
                                                    ? Palette.foreground.darker(0.2)
                                                    : Palette.foreground.transparentize(0.5));
                                        }
                                    }

                                    VerticalBox {
                                        padding: 0;
                                        spacing: 1px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: row.name;
                                            font-weight: 600;
                                            color: i == root.selected ? Palette.accent-foreground : Palette.foreground;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.kind;
                                            font-size: 11px;
                                            color: i == root.selected ? Palette.accent-foreground : Palette.foreground.darker(0.2);
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            if root.devices.length == 0 : Text {
                                text: "No devices found.";
                                color: Palette.foreground.darker(0.2);
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ── Detail: selected device ──────────────────────────────────────────
        Rectangle {
            background: Palette.background;
            horizontal-stretch: 1;

            if !root.has-selection : Text {
                text: "Select a device to view its information.";
                color: Palette.foreground.darker(0.2);
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.has-selection : VerticalBox {
                padding: 16px;
                spacing: 10px;

                // Header
                Text {
                    text: root.sel.name;
                    font-size: 18px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.sel.kind + " — " + root.sel.address;
                    color: Palette.foreground.darker(0.2);
                    font-size: 12px;
                    overflow: elide;
                }

                // Queried information
                Text { text: "Information"; font-weight: 700; }
                // The only child that grows: every row below pins itself to its
                // natural height, so spare vertical space lands here rather than
                // stretching the input rows and squeezing this into a scrollbox.
                Rectangle {
                    border-radius: 8px;
                    background: Palette.alternate-background;
                    vertical-stretch: 1;
                    min-height: 120px;

                    // ScrollView (like TextEdit) is stretch-sized with no
                    // preferred size of its own, so it must sit in a layout —
                    // as a bare child of this Rectangle it would collapse to
                    // zero and render nothing.
                    VerticalLayout {
                        padding: 12px;

                        ScrollView {
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                if root.error-text != "" : Text {
                                    text: root.error-text;
                                    color: #ef4444;
                                    wrap: word-wrap;
                                }

                                if root.error-text == "" && root.info-rows.length == 0 : Text {
                                    text: root.busy ? "Querying…" : "No information returned.";
                                    color: Palette.foreground.darker(0.2);
                                }

                                for info[i] in root.info-rows : HorizontalLayout {
                                    spacing: 12px;
                                    // Sections get breathing room above, except
                                    // the first, which sits flush with the top.
                                    padding-top: info.is-section && i > 0 ? 10px : 0;

                                    if info.is-section : Text {
                                        text: info.label;
                                        font-weight: 700;
                                        horizontal-stretch: 1;
                                    }

                                    if !info.is-section : Text {
                                        text: info.label;
                                        width: 130px;
                                        color: Palette.foreground.darker(0.2);
                                        overflow: elide;
                                    }
                                    if !info.is-section : Text {
                                        text: info.value;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Editable settings (printer families only) ────────────────
                if root.sel.has-settings : Text { text: "Settings"; font-weight: 700; }

                // StyleWriter and ImageWriter both expose the name and nothing
                // else, and both cap it at 31 characters.
                if root.sel.is-stylewriter || root.sel.is-imagewriter : HorizontalBox {
                    vertical-stretch: 0;
                    padding: 0;
                    Text { text: "Name"; width: Layout.label-width; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.edit-name;
                        placeholder-text: "Printer name (1–\{root.name-max} characters)";
                        enabled: root.detail-loaded && !root.busy;
                        horizontal-stretch: 1;
                        height: Layout.row-height;
                    }
                }

                if root.sel.is-laserwriter : VerticalBox {
                    vertical-stretch: 0;
                    padding: 0;

                    HorizontalBox {
                        vertical-stretch: 0;
                        padding: 0;
                        Text { text: "Name"; width: Layout.label-width; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.edit-name;
                            placeholder-text: "Printer name (1–\{root.name-max} characters)";
                            enabled: root.detail-loaded && !root.busy;
                            horizontal-stretch: 1;
                            height: Layout.row-height;
                        }
                    }

                    HorizontalBox {
                        vertical-stretch: 0;
                        padding: 0;
                        Text { text: "Default Paper Size"; width: Layout.label-width; vertical-alignment: center; }
                        ComboBox {
                            model: ["Letter", "A4", "Legal", "Executive", "B5"];
                            current-index <=> root.paper-index;
                            enabled: root.detail-loaded && !root.busy;
                            horizontal-stretch: 1;
                            height: Layout.row-height;
                        }
                    }

                    HorizontalBox {
                        vertical-stretch: 0;
                        padding: 0;
                        Text { text: "Startup Page"; width: Layout.label-width; vertical-alignment: center; }
                        CheckBox {
                            checked <=> root.startup-enabled;
                            enabled: root.detail-loaded && !root.busy;
                            accessible-description: "Print a test page at power-on";

                            Tooltip {
                                // Tooltip takes styled text, so plain strings
                                // have to be wrapped.
                                text: @markdown("Print a test page at power-on");
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // ── Ping test (every device answers AEP, printer or not) ─────
                Text { text: "Ping Test"; font-weight: 700; }

                HorizontalBox {
                    vertical-stretch: 0;
                    padding: 0;
                    spacing: 8px;

                    Text { text: "Packets"; vertical-alignment: center; }
                    NumberField {
                        width: 88px;
                        height: Layout.row-height;
                        minimum: 1;
                        maximum: root.ping-count-max;
                        value <=> root.ping-count;
                        enabled: !root.ping-busy;
                    }
                    Text { text: "Bytes"; vertical-alignment: center; }
                    NumberField {
                        width: 96px;
                        height: Layout.row-height;
                        minimum: root.ping-size-min;
                        maximum: root.ping-size-max;
                        value <=> root.ping-size;
                        enabled: !root.ping-busy;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.ping-busy ? "Running…" : "Run Test";
                        enabled: !root.ping-busy;
                        clicked => { root.run-ping-test(root.selected); }
                    }
                    Button {
                        text: "Stop";
                        enabled: root.ping-busy;
                        clicked => { root.stop-ping-test(); }
                    }
                }

                HorizontalBox {
                    vertical-stretch: 0;
                    padding: 0;
                    spacing: 8px;
                    Stat { label: "Average"; value: root.ping-average; }
                    Stat { label: "Fastest"; value: root.ping-fastest; }
                    Stat { label: "Slowest"; value: root.ping-slowest; }
                    Stat { label: "Loss"; value: root.ping-loss; }
                }

                // Always rendered, empty or not: an appearing line would shove
                // everything above it as soon as a test started.
                Text {
                    text: root.ping-status;
                    font-size: 11px;
                    color: Palette.foreground.darker(0.2);
                    overflow: elide;
                }

                // Status line and Save, pinned to the foot of the pane.
                HorizontalBox {
                    vertical-stretch: 0;
                    padding: 0;
                    spacing: 8px;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.busy ? #f59e0b : #22c55e;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.status-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.sel.has-settings : Button {
                        text: "Save";
                        primary: true;
                        enabled: root.detail-loaded && !root.busy && root.edit-name != "";
                        clicked => { root.save(root.selected); }
                    }
                }
            }
        }
    }
}
